# ADB Settings
ADB_HOST=127.0.0.1
ADB_PORT=5555

# LDPlayer Resolution
SCREEN_WIDTH=720
SCREEN_HEIGHT=1280

# Ollama Settings (AI Vision)
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=moondream:1.8b
# Alternative: qwen2.5vl:7b (plus precis mais ~10GB RAM)

# Vision Settings
TEMPLATE_MATCH_THRESHOLD=0.85
OCR_LANGUAGE=fra
ENABLE_AI_FALLBACK=true

# Bot Settings
ACTION_DELAY_MIN=1.0
ACTION_DELAY_MAX=3.0
CHECK_INTERVAL_MIN=5
CHECK_INTERVAL_MAX=15

# Safety Settings
ENABLE_RANDOM_DELAYS=true
ENABLE_HUMAN_BEHAVIOR=true
MAX_CONSECUTIVE_ACTIONS=50
BREAK_DURATION_MIN=300
BREAK_DURATION_MAX=600

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
SAVE_SCREENSHOTS=false
